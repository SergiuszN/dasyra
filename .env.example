# Copy to .env and fill in. Only the first three are required.
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
# Your own Telegram chat id: the owner account (user 1) is bound to it on first start
TELEGRAM_CHAT_ID=

# Webhook mode (`dasyra serve`): Telegram sends this secret in every update
TELEGRAM_WEBHOOK_SECRET=
# Admin panel at /panel, closed while either is empty
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Server time zone; new users start in it until they tell Dasyra theirs
SERVER_TZ=UTC
# DB_PATH=db.sqlite
# LISTEN=:8080
# SEARXNG_URL=http://localhost:8888
# Brave Search API key (api-dashboard.search.brave.com): searched when SearXNG fails, before ddgr
# BRAVE_API_KEY=
# LOG_LEVEL=debug
